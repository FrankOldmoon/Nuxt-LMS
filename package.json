{
  "name": "hub",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=128' nuxt build",
    "dev": "nuxt-hub db migrate && nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "pm": "pm2 restart ecosystem.config.cjs",
    "server": "nuxt-hub db migrate && node .output/server/index.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "vendor": "node scripts/copy-vendor-assets.mjs",
    "db:migrate": "nuxt-hub db migrate"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "@electric-sql/pglite": "^0.5.3",
    "@nuxt/ui": "^4.9.0",
    "@nuxthub/core": "0.10.7",
    "@nuxtjs/i18n": "10.4.0",
    "@tiptap/core": "^3.27.1",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "@umoteam/editor": "^11.1.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pptx": "^1.0.1",
    "browser-image-compression": "^2.0.2",
    "chevrotain": "^13.2.0",
    "colyseus": "^0.15.0",
    "colyseus.js": "^0.15.28",
    "docx": "^9.7.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "echarts": "5.6.0",
    "edge-tts-universal": "^1.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "monaco-editor": "0.52.2",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.4.8",
    "phaser": "3.80.1",
    "postgres": "^3.4.9",
    "pyodide": "0.26.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.38",
    "vue-advanced-cropper": "^2.8.9",
    "vue-demi": "^0.14.10",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.115",
    "@iconify-json/vscode-icons": "^1.2.83",
    "@nuxt/test-utils": "^4.0.3",
    "@pintora/standalone": "0.8.1",
    "@tailwindcss/browser": "4",
    "@types/nodemailer": "^8.0.1",
    "@umoteam/editor-external": "10.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "html2canvas": "1.4.1",
    "less": "^4.6.7",
    "pdfjs-dist": "4.0.379",
    "playwright-core": "^1.61.1",
    "pptxgenjs": "3.12.0",
    "reveal.js": "5",
    "simple-mind-map": "0.10.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vuedraggable": "^4.1.0",
    "xlsx": "0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vue-office/docx",
      "@vue-office/excel",
      "@vue-office/pptx",
      "vue-demi",
      "esbuild",
      "sharp"
    ]
  }
}
