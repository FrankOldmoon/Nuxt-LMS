# nginx 反向代理示例（宝塔版 nginx 放在 /www/server/panel/vhost/nginx/lms_app.conf）
# 作用：把 80 端口的请求轮询分发给 8 个 Nuxt 实例（127.0.0.1:3001-3008）。
# 关键：location 里必须 proxy_cache off / proxy_buffering off，避免 SSR 动态页被 nginx 缓存。

upstream lms_upstream {
    server 127.0.0.1:3001;
    server 127.0.0.1:3002;
    server 127.0.0.1:3003;
    server 127.0.0.1:3004;
    server 127.0.0.1:3005;
    server 127.0.0.1:3006;
    server 127.0.0.1:3007;
    server 127.0.0.1:3008;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    location / {
        proxy_pass http://lms_upstream;
        proxy_cache off;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
    }
}