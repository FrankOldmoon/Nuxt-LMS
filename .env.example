PORT = 80
POSTGRES_URL=postgresql://postgres:root@localhost:5432/nuxt_hub
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
SITE_URL=http://localhost:3000

# AI Chat 配置（aichat 组件使用）
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# 模块开关（脚手架阶段 false 使用原始 app/server 文件；置 true 启用对应模块）
# base 必须为 true 才能启用 doc/lms
NUXT_MODULE_BASE=false
NUXT_MODULE_DOC=false

NUXT_MODULE_BASE=true
NUXT_MODULE_LMS=true
NUXT_MODULE_ADMIN=true
NUXT_MODULE_MMO=true

# MMO Colyseus WebSocket 端口（默认 2567）
MMO_WS_PORT=2567
