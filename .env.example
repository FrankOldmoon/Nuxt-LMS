PORT = 80
POSTGRES_URL=postgresql://postgres:root@localhost:5432/nuxt_hub
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
SITE_URL=http://localhost:3000

# 仅该域名（不带端口）在首页做 Access Verification，其他访问直接放行；留空则全部放行
NUXT_PUBLIC_VERIFICATION_URL=

# 访问门 startup_token 的 HMAC 签名密钥（生产环境必填）
# 未配置时：生产环境拒绝签发/校验 startup token；开发环境回退默认密钥并告警
NUXT_STARTUP_SECRET=

# 首次启动播种账号的初始密码（仓库内不保存明文口令）
# - admin / observer：留空则随机生成，并在启动日志打印一次
# - test01~test30：留空则不创建这些演示账号
NUXT_SEED_ADMIN_PASSWORD=
NUXT_SEED_OBSERVER_PASSWORD=
NUXT_SEED_TEST_PASSWORD=
# 批量导入用户时的默认密码（留空则每条导入记录必须显式提供 password）
NUXT_IMPORT_DEFAULT_PASSWORD=

# 监控页 /monitor 查看密码（未配置时监控接口拒绝访问）
NUXT_MONITOR_VIEW_PASSWORD=

# Dify 悬浮聊天机器人（右下角）；token 留空则全站不注入
NUXT_PUBLIC_DIFY_TOKEN=
NUXT_PUBLIC_DIFY_BASE_URL=

# AI Chat 配置（aichat 组件使用）
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# PeerTube 视频上传（ueditor 上传视频时走 PeerTube 并插入 embed iframe）
# 留空（url/username/password 任一为空）时，视频上传回退为普通文件上传方式
NUXT_PEERTUBE_URL=
NUXT_PEERTUBE_USERNAME=
NUXT_PEERTUBE_PASSWORD=
NUXT_PEERTUBE_PRIVACY=1
NUXT_PEERTUBE_CHANNEL_ID=1
# 视频大小上限（MB），默认 2048（2GB）
NUXT_PEERTUBE_MAX_SIZE_MB=2048

NUXT_MODULE_BASE=true
NUXT_MODULE_LMS=true
NUXT_MODULE_ADMIN=true
NUXT_MODULE_MMO=true

# MMO Colyseus WebSocket 端口（默认 2567）
MMO_WS_PORT=2567

NUXT_MODULE_CHAT=true

# /chat Agent 的 http_request 工具白名单（逗号分隔 host，留空=禁用该工具）
# 例：NUXT_CHAT_HTTP_ALLOW=api.github.com,10.28.1.152
NUXT_CHAT_HTTP_ALLOW=

# /chat 发布网页到 MINXIN Git（10.28.1.160）
# 管理员 token 只用于服务端代建仓库/提交文件，不会下发给浏览器
NUXT_GITEA_BASE=http://10.28.1.160
NUXT_GITEA_ADMIN_TOKEN=
# Gitea 里 LMS OIDC 登录源的 id（用于自动开通账号，默认 2）
# NUXT_GITEA_LOGIN_SOURCE_ID=2
